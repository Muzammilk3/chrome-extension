# Database Configuration
MONGODB_URI=mongodb://localhost:27017/productivity_tracker
MONGODB_TEST_URI=mongodb://localhost:27017/productivity_tracker_test

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_please_change_in_production
JWT_EXPIRES_IN=7d

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,chrome-extension://

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Email Configuration (Gmail)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=Productivity Tracker <noreply@productivitytracker.com>

# SendGrid Configuration (Production)
SENDGRID_USERNAME=apikey
SENDGRID_PASSWORD=your-sendgrid-api-key

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Frontend URL
FRONTEND_URL=http://localhost:3000

# File Upload Configuration
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif

# Analytics and Monitoring
ANALYTICS_ENABLED=false
SENTRY_DSN=your-sentry-dsn-for-error-tracking

# Background Jobs
ENABLE_SCHEDULED_REPORTS=true
REPORT_CLEANUP_DAYS=90

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET=your-session-secret-key

# Cache Configuration (if using Redis)
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600
